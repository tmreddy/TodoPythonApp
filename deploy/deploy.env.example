# Copy this file to deploy.env and edit it. deploy.env is gitignored.
#
#     cp deploy/deploy.env.example deploy/deploy.env
#
# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# Preferred: use a named AWS CLI profile and leave the keys blank.
#AWS_PROFILE=my-sandbox

# Alternative: put keys here. Works, but a profile keeps secrets out of the
# project directory entirely. Never commit this file with keys filled in.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Naming
# ---------------------------------------------------------------------------
# Every resource is named from this prefix, so two stacks can coexist:
#   ${STACK}-ec2-sg  ${STACK}-rds-sg  ${STACK}-db  ${STACK}-key  ${STACK}-api
STACK=todo

# ---------------------------------------------------------------------------
# Application source
# ---------------------------------------------------------------------------
REPO_URL=https://github.com/tmreddy/TodoPythonApp.git
REPO_BRANCH=main
APP_DIR_NAME=TodoPythonApp

# Set to 1 to rsync your local working tree instead of cloning from the remote.
# Use this when you want to deploy uncommitted changes.
DEPLOY_LOCAL_TREE=0

# ---------------------------------------------------------------------------
# Sizing
# ---------------------------------------------------------------------------
EC2_INSTANCE_TYPE=t3.micro
EC2_VOLUME_GB=20

DB_INSTANCE_CLASS=db.t3.micro
DB_ENGINE_VERSION=18.6
DB_ALLOCATED_GB=20
DB_MASTER_USER=todouser
DB_NAME=todo_db

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
APP_PORT=8000
CLOUDWATCH_LOG_GROUP=todo-api-logs

# CIDR allowed to SSH in. Leave blank to auto-detect your current public IP
# as a /32. Set explicitly if you are behind a changing NAT.
SSH_CIDR=
